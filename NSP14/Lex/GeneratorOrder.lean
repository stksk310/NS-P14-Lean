module
public import NSP14.Lex.LinearQuotients
public import Mathlib.Data.Finset.Sort
public import Mathlib.Data.Finset.Max
@[expose] public section
set_option backward.isDefEq.respectTransparency false
open scoped Classical
namespace NSP14.Lex
variable (q : ℕ)

theorem precedes_trans {a b c : Fin q →₀ ℕ}
    (hab : precedes q a b) (hbc : precedes q b c) : precedes q a c := by
  rcases hab with hab|⟨hdab,hlab⟩
  · left
    rcases hbc with hbc|⟨hdbc,_⟩ <;> omega
  · rcases hbc with hbc|⟨hdbc,hlbc⟩
    · left; omega
    · exact Or.inr ⟨hdab.trans hdbc,hlbc.trans hlab⟩

theorem not_precedes_self (a : Fin q →₀ ℕ) : ¬precedes q a a := by
  rintro (h|⟨_,h⟩) <;> exact lt_irrefl _ h

theorem precedes_trichotomy (a b : Fin q →₀ ℕ) :
    precedes q a b ∨ a=b ∨ precedes q b a := by
  rcases lt_trichotomy a.degree b.degree with h|h|h
  · exact Or.inl (Or.inl h)
  · rcases lt_trichotomy (MonomialOrder.lex.toSyn a) (MonomialOrder.lex.toSyn b) with hl|hl|hl
    · exact Or.inr (Or.inr (Or.inr ⟨h.symm,hl⟩))
    · exact Or.inr (Or.inl (MonomialOrder.lex.toSyn.injective hl))
    · exact Or.inl (Or.inr ⟨h,hl⟩)
  · exact Or.inr (Or.inr (Or.inl h))

def precedesOrEq (a b : Fin q →₀ ℕ) : Prop := precedes q a b ∨ a=b

instance : IsTrans (Fin q →₀ ℕ) (precedesOrEq q) where
  trans a b c hab hbc := by
    rcases hab with hab|rfl
    · rcases hbc with hbc|rfl
      · exact Or.inl (precedes_trans q hab hbc)
      · exact Or.inl hab
    · exact hbc

instance : Std.Antisymm (precedesOrEq q) where
  antisymm a b hab hba := by
    rcases hab with hab|hab
    · rcases hba with hba|hba
      · exact False.elim (not_precedes_self q a (precedes_trans q hab hba))
      · exact hba.symm
    · exact hab

instance : Std.Total (precedesOrEq q) where
  total a b := by
    rcases precedes_trichotomy q a b with h|h|h
    · exact Or.inl (Or.inl h)
    · exact Or.inl (Or.inr h)
    · exact Or.inr (Or.inl h)

theorem precedes_of_le {a b c : Fin q →₀ ℕ} (hab : a ≤ b) (hbc : precedes q b c) :
    precedes q a c := by
  by_cases he : a=b
  · simpa only [he] using hbc
  have hd := exponent_degree_strict q hab he
  left
  rcases hbc with hbc|⟨hbc,_⟩ <;> omega

theorem maxVariable_spec (v : Fin q →₀ ℕ) (hv : v ≠ 0) :
    ∃ r : Fin q, 0 < v r ∧ maxVariable q v=r.val+1 ∧ ∀ i, r < i → v i=0 := by
  have hs := Finsupp.support_nonempty_iff.mpr hv
  let r := v.support.max' hs
  have hr : r ∈ v.support := Finset.max'_mem v.support hs
  have hmax : ∀ i ∈ v.support,i ≤ r := fun i hi => Finset.le_max' _ i hi
  refine ⟨r,Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hr),?_,?_⟩
  · unfold maxVariable
    apply le_antisymm
    · apply Finset.sup_le
      intro i hi
      have h := hmax i hi
      exact Nat.add_le_add_right h 1
    · exact Finset.le_sup (f:=fun i : Fin q => i.val+1) hr
  · intro i hi
    by_contra hn
    have h := hmax i (Finsupp.mem_support_iff.mpr hn)
    exact not_lt_of_ge h hi

variable (k : Type) [Field k]

theorem minimalGenerator_ne_zero (L : Ideal (MvPolynomial (Fin q) k)) (hL : L ≠ ⊤)
    (v : Fin q →₀ ℕ) (hv : MinimalGenerator k q L v) : v ≠ 0 := by
  intro hz
  have h1 : (1:MvPolynomial (Fin q) k) ∈ L := by simpa only [hz,MvPolynomial.monomial_zero',map_one] using hv.1
  exact hL ((Ideal.eq_top_iff_one L).mpr h1)

noncomputable def generatorList (L : Ideal (MvPolynomial (Fin q) k)) : List (Fin q →₀ ℕ) :=
  (minimalGeneratorFinset k q L).sort (precedesOrEq q)

theorem generatorList_toFinset (L : Ideal (MvPolynomial (Fin q) k)) :
    (generatorList q k L).toFinset=minimalGeneratorFinset k q L :=
  Finset.sort_toFinset _ _

theorem generatorList_pairwise (L : Ideal (MvPolynomial (Fin q) k)) :
    (generatorList q k L).Pairwise (precedes q) := by
  have hp := Finset.pairwise_sort (minimalGeneratorFinset k q L) (precedesOrEq q)
  have hn := Finset.sort_nodup (minimalGeneratorFinset k q L) (precedesOrEq q)
  exact (hp.and hn).imp (fun hab => hab.1.resolve_right hab.2)

/-- The previous ideal is generated by exactly the preceding actual
minimal generators of L. It is not an assumed finite presentation. -/
theorem predecessorIdeal_minimal (L : Ideal (MvPolynomial (Fin q) k)) (w : Fin q →₀ ℕ) :
    predecessorIdeal k q L w =
      Ideal.span ((fun v => MvPolynomial.monomial v (1:k)) ''
        {v | MinimalGenerator k q L v ∧ precedes q v w}) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨v,⟨hv,hpre⟩,rfl⟩
    obtain ⟨a,ha,hmin⟩ := minimal_divisor k q L v hv
    apply monomial_mem_of_le k q _ a v _ ha
    exact Ideal.subset_span ⟨a,⟨hmin,precedes_of_le q ha hpre⟩,rfl⟩
  · apply Ideal.span_le.mpr
    rintro _ ⟨v,⟨hv,hpre⟩,rfl⟩
    exact Ideal.subset_span ⟨v,⟨hv.1,hpre⟩,rfl⟩

end NSP14.Lex
