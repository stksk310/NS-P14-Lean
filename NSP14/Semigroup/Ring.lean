module

public import NSP14.Semigroup.Order
public import Mathlib.Algebra.MonoidAlgebra.Ideal
public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Ideal.BigOperators

@[expose] public section

open scoped BigOperators

namespace NSP14.NumericalSemigroup

variable (S : NSP14.NumericalSemigroup) (k : Type*) [CommRing k]

/-- The algebraic semigroup ring; no completion is implicit. -/
abbrev SemigroupRing := AddMonoidAlgebra k S.carrier

/-- The monomial ideal cut out by the numerical order threshold. -/
noncomputable def orderIdeal (n : ℕ) : Ideal (S.SemigroupRing k) :=
  Ideal.span (AddMonoidAlgebra.of' k S.carrier '' {x | n ≤ S.order x.val})

/-- The ideal generated by all positive semigroup monomials. -/
noncomputable def positiveIdeal : Ideal (S.SemigroupRing k) :=
  Ideal.span (AddMonoidAlgebra.of' k S.carrier '' {x | 0 < x.val})

theorem mem_orderIdeal_iff (n : ℕ) (f : S.SemigroupRing k) :
    f ∈ S.orderIdeal k n ↔ ∀ x ∈ f.coeff.support, n ≤ S.order x.val := by
  classical
  rw [orderIdeal, AddMonoidAlgebra.mem_ideal_span_of'_image]
  constructor
  · intro h x hx
    obtain ⟨y, hy, z, rfl⟩ := h x hx
    have := S.order_add z.property y.property
    change n ≤ S.order (z.val + y.val)
    exact le_trans hy (by omega)
  · intro h x hx
    exact ⟨x, h x hx, 0, by simp⟩

theorem mem_orderIdeal_coeff (n : ℕ) (f : S.SemigroupRing k) :
    f ∈ S.orderIdeal k n ↔ ∀ x, S.order x.val < n → f.coeff x = 0 := by
  classical
  rw [S.mem_orderIdeal_iff]
  simp only [Finsupp.mem_support_iff]
  constructor
  · intro h x hx
    by_contra hn
    exact (Nat.not_le_of_lt hx) (h x hn)
  · intro h x hx
    by_contra hn
    exact hx (h x (by omega))

theorem single_mem_orderIdeal (n : ℕ) (x : S.carrier) (c : k)
    (hx : n ≤ S.order x.val) : AddMonoidAlgebra.single x c ∈ S.orderIdeal k n := by
  classical
  rw [S.mem_orderIdeal_iff]
  intro y hy
  have : y = x := Finset.mem_singleton.mp (Finsupp.support_single_subset hy)
  simpa [this] using hx

theorem single_mem_orderIdeal_iff [Nontrivial k] (n : ℕ) (x : S.carrier) :
    AddMonoidAlgebra.single x (1 : k) ∈ S.orderIdeal k n ↔ n ≤ S.order x.val := by
  classical
  rw [S.mem_orderIdeal_iff]
  simp

theorem orderIdeal_antitone {n p : ℕ} (h : n ≤ p) :
    S.orderIdeal k p ≤ S.orderIdeal k n := by
  intro f hf
  rw [S.mem_orderIdeal_iff] at hf ⊢
  exact fun x hx => le_trans h (hf x hx)

theorem orderIdeal_zero : S.orderIdeal k 0 = ⊤ := by
  apply top_unique
  intro f _
  exact (S.mem_orderIdeal_iff k 0 f).2 (fun _ _ => Nat.zero_le _)

theorem orderIdeal_one : S.orderIdeal k 1 = S.positiveIdeal k := by
  unfold orderIdeal positiveIdeal
  apply congrArg Ideal.span
  apply congrArg (fun t : Set S.carrier => AddMonoidAlgebra.of' k S.carrier '' t)
  ext x
  change 1 ≤ S.order x.val ↔ 0 < x.val
  constructor
  · intro h
    by_contra hn
    have hx : x.val = 0 := by omega
    simp [hx, S.order_zero] at h
  · exact S.order_pos x.property

/-- An ideal contains a polynomial if it contains every supported monomial. -/
theorem mem_of_support_single_mem (I : Ideal (S.SemigroupRing k)) (f : S.SemigroupRing k)
    (h : ∀ x ∈ f.coeff.support, AddMonoidAlgebra.single x (f.coeff x) ∈ I) : f ∈ I := by
  rw [← f.sum_coeff_single]
  exact I.sum_mem h

theorem orderIdeal_mul_le (n p : ℕ) :
    S.orderIdeal k n * S.orderIdeal k p ≤ S.orderIdeal k (n + p) := by
  classical
  apply Ideal.mul_le.mpr
  intro f hf g hg
  rw [S.mem_orderIdeal_iff] at hf hg
  rw [AddMonoidAlgebra.mul_def]
  apply (S.orderIdeal k (n + p)).sum_mem
  intro x hx
  apply (S.orderIdeal k (n + p)).sum_mem
  intro y hy
  apply S.single_mem_orderIdeal
  have ho := S.order_add x.property y.property
  change n + p ≤ S.order (x.val + y.val)
  have := hf x hx
  have := hg y hy
  omega

end NSP14.NumericalSemigroup
