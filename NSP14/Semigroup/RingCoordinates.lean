module

public import NSP14.Semigroup.IdealPowers
public import Mathlib.RingTheory.Ideal.Maps

@[expose] public section

open scoped BigOperators

namespace NSP14.NumericalSemigroup

variable (S : NSP14.NumericalSemigroup) (k : Type*) [CommRing k]

theorem constantCoeff_mul (f g : S.SemigroupRing k) :
    (f * g).coeff 0 = f.coeff 0 * g.coeff 0 := by
  classical
  have hz (x y : S.carrier) : x + y = 0 ↔ x = 0 ∧ y = 0 := by
    constructor
    · intro h
      have hv := congrArg Subtype.val h
      change x.val + y.val = 0 at hv
      exact ⟨Subtype.ext (by change _ = (0 : ℕ); omega),
        Subtype.ext (by change _ = (0 : ℕ); omega)⟩
    · rintro ⟨rfl, rfl⟩; simp
  rw [AddMonoidAlgebra.coeff_mul]
  simp only [hz, ite_and, Finsupp.sum]
  rw [Finset.sum_eq_single 0]
  · rw [Finset.sum_eq_single 0]
    · simp
    · intro b _ hb; simp [hb]
    · intro hb
      have hg : g.coeff 0 = 0 := Finsupp.notMem_support_iff.mp hb
      simp [hg]
  · intro a _ ha; simp [ha]
  · intro ha
    have hf : f.coeff 0 = 0 := Finsupp.notMem_support_iff.mp ha
    simp [hf]

/-- Constant-coefficient map; its kernel is maximal when the coefficient ring is a field. -/
noncomputable def constantCoeff : S.SemigroupRing k →+* k where
  toFun f := f.coeff 0
  map_zero' := rfl
  map_one' := by simp
  map_add' := by intros; simp
  map_mul' := S.constantCoeff_mul k

theorem constantCoeff_surjective : Function.Surjective (S.constantCoeff k) := by
  intro c
  refine ⟨AddMonoidAlgebra.single 0 c, ?_⟩
  change (AddMonoidAlgebra.single (0 : S.carrier) c).coeff 0 = c
  simp

theorem constantCoeff_ker : RingHom.ker (S.constantCoeff k) = S.positiveIdeal k := by
  ext f
  exact (S.mem_positiveIdeal k f).symm

theorem positiveIdeal_isMaximal (K : Type*) [Field K] : (S.positiveIdeal K).IsMaximal := by
  rw [← S.constantCoeff_ker K]
  exact RingHom.ker_isMaximal_of_surjective _ (S.constantCoeff_surjective K)

/-- Every positive exponent has an actual atom as an additive factor. -/
theorem positive_atom_summand (x : S.carrier) (hx : 0 < x.val) :
    ∃ a : S.carrier, S.IsAtom a.val ∧ ∃ b : S.carrier, x = b + a := by
  have ho := S.order_pos x.property hx
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt ho)
  have hex := S.order_realized_by_atoms x.property
  rw [hn] at hex
  obtain ⟨f, hf, hsum⟩ := hex
  let b : S.carrier := ⟨∑ i : Fin n, f i.succ,
    S.sum_mem Finset.univ _ (fun i _ => (hf i.succ).1)⟩
  refine ⟨⟨f 0, (hf 0).1⟩, hf 0, b, ?_⟩
  apply Subtype.ext
  simpa [b, Fin.sum_univ_succ, add_comm] using hsum.symm

/-- The same positive ideal is generated by the actual minimal semigroup generators. -/
theorem positiveIdeal_eq_atom_span : S.positiveIdeal k =
    Ideal.span (AddMonoidAlgebra.of' k S.carrier '' {x | S.IsAtom x.val}) := by
  classical
  apply le_antisymm
  · intro f hf
    rw [AddMonoidAlgebra.mem_ideal_span_of'_image]
    intro x hx
    have hn := (S.mem_orderIdeal_iff k 1 f).1 ((S.orderIdeal_one k) ▸ hf) x hx
    have hp : 0 < x.val := by
      by_contra h
      have hz : x.val = 0 := by omega
      simp [hz, S.order_zero] at hn
    obtain ⟨a, ha, b, hb⟩ := S.positive_atom_summand x hp
    exact ⟨a, ha, b, hb⟩
  · rw [Ideal.span_le]
    rintro _ ⟨x, hx, rfl⟩
    exact S.positive_single_mem k x hx.2.1

end NSP14.NumericalSemigroup
