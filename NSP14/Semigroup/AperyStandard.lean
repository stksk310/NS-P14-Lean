module

public import NSP14.Semigroup.AperyProducts
public import NSP14.Semigroup.AperyDimensions
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Artinian.Module

@[expose] public section

open scoped Classical BigOperators

namespace NSP14.NumericalSemigroup

variable (S : NSP14.NumericalSemigroup) (k : Type*) [CommRing k] [Nontrivial k]

omit [Nontrivial k] in
theorem initialMonomial_zero : S.initialMonomial k (0 : S.carrier) = 1 := by
  change DirectSum.of (S.GradedPiece k) (S.order 0) (S.monomialClass k _ 0 le_rfl) =
    DirectSum.of (S.GradedPiece k) 0 (Submodule.Quotient.mk (S.zeroRepresentative k 1))
  apply DirectSum.of_eq_of_gradedMonoid_eq
  apply S.homogeneous_mk_eq k S.order_zero
  rfl

theorem qMonomial_zero : S.qMonomial k (0 : S.carrier) = 1 := by
  rw [← S.toAperyAlgebra_initial, S.initialMonomial_zero, map_one]

/-- A longest Apéry factorization can be peeled into an atom and a live shorter Apéry term. -/
theorem apery_atomic_split (x : S.carrier) (hx : x.val ∈ S.aperySet) (hpos : 0 < x.val) :
    ∃ a v : S.carrier, S.IsAtom a.val ∧ a.val ≠ S.multiplicity ∧ v.val ∈ S.aperySet ∧
      x = a + v ∧ S.order (a.val + v.val) = S.order a.val + S.order v.val := by
  have ho := S.order_pos x.property hpos
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt ho)
  have hex := S.order_realized_by_atoms x.property
  rw [hn] at hex
  obtain ⟨f, hf, hsum⟩ := hex
  let a : S.carrier := ⟨f 0, (hf 0).1⟩
  let v : S.carrier := ⟨∑ i : Fin n, f i.succ, S.sum_mem Finset.univ _ (fun i _ => (hf i.succ).1)⟩
  have heq : x = a + v := Subtype.ext (by simpa [a, v, Fin.sum_univ_succ] using hsum.symm)
  have hval : x.val = a.val + v.val := congrArg Subtype.val heq
  have hap := S.apery_summands a.property v.property (hval ▸ hx)
  have ha : S.IsAtom a.val := hf 0
  have hm : a.val ≠ S.multiplicity := by intro he; exact S.multiplicity_not_apery (he ▸ hap.1)
  have hv : n ≤ S.order v.val := S.atomic_length_le (fun i : Fin n => f i.succ)
    (fun i => hf i.succ) rfl
  have hadd := S.order_add a.property v.property
  have haord := S.atom_order ha
  rw [← hval, hn, haord] at hadd
  refine ⟨a, v, ha, hm, hap.2, heq, ?_⟩
  rw [← hval, hn, haord]
  omega

noncomputable def aperyAtomSubalgebra : Subalgebra k (S.AperyAlgebra k) :=
  Algebra.adjoin k (S.qMonomial k '' {a : S.carrier | S.IsAtom a.val ∧ a.val ≠ S.multiplicity})

theorem aperyMonomial_mem_atomSubalgebra (x : S.AperyExponent) :
    S.qMonomial k x.val ∈ S.aperyAtomSubalgebra k := by
  have gen : ∀ n, ∀ hn : n ∈ S, n ∈ S.aperySet →
      S.qMonomial k ⟨n, hn⟩ ∈ S.aperyAtomSubalgebra k := by
    intro n
    induction n using Nat.strong_induction_on with
    | ind n ih =>
      intro hn hx
      by_cases hz : n = 0
      · subst n
        have he : (⟨0, hn⟩ : S.carrier) = 0 := rfl
        rw [he, S.qMonomial_zero]
        exact (S.aperyAtomSubalgebra k).one_mem
      let z : S.carrier := ⟨n, hn⟩
      obtain ⟨a, v, ha, hm, hv, heq, hlive⟩ := S.apery_atomic_split z hx (by change 0 < n; omega)
      have hvlt : v.val < n := by
        have hval := congrArg Subtype.val heq
        change n = a.val + v.val at hval
        have hapos := ha.2.1
        omega
      have hva := ih v.val hvlt v.property hv
      have haa : S.qMonomial k a ∈ S.aperyAtomSubalgebra k :=
        Algebra.subset_adjoin ⟨a, ⟨ha, hm⟩, rfl⟩
      have hp := (S.aperyAtomSubalgebra k).mul_mem haa hva
      have he : S.qMonomial k a * S.qMonomial k v = S.qMonomial k z :=
        (S.qMonomial_mul_live k a v hlive).trans (congrArg (S.qMonomial k) heq.symm)
      exact he ▸ hp
  exact gen x.val.val x.val.property x.property

/-- Q is generated by its actual non-multiplicity atom classes. -/
theorem apery_atom_adjoin_top : S.aperyAtomSubalgebra k = ⊤ := by
  apply top_unique
  intro a _
  have he := (S.aperyQuotientBasis k).linearCombination_repr a
  rw [← he, Finsupp.linearCombination_apply, Finsupp.sum]
  apply (S.aperyAtomSubalgebra k).sum_mem
  intro x _
  apply (S.aperyAtomSubalgebra k).smul_mem
  exact (S.aperyQuotientBasis_eq_initial k x).symm ▸ S.aperyMonomial_mem_atomSubalgebra k x

theorem apery_atom_generator_degree (a : S.carrier) (ha : S.IsAtom a.val) (hm : a.val ≠ S.multiplicity) :
    S.qMonomial k a ∈ S.qDegree k 1 ∧ S.qMonomial k a ≠ 0 :=
  ⟨S.qMonomial_mem_degree k a 1 (S.atom_order ha), S.qMonomial_ne_zero k ⟨a, S.atom_apery ha hm⟩⟩

noncomputable instance aperyAlgebraArtinian (K : Type*) [Field K] : IsArtinianRing (S.AperyAlgebra K) :=
  IsArtinianRing.of_finite K (S.AperyAlgebra K)

end NSP14.NumericalSemigroup
