NSP14.Lex.genericDistraction_totalBetti : ∀ (k : Type) [inst : Field k] (q : ℕ)
  (I : Ideal (MvPolynomial (Fin q) (NSP14.Lex.GenericDistractionField k q))),
  NSP14.Lex.IsMonomial (NSP14.Lex.GenericDistractionField k q) q I →
    ∀ (i : ℕ),
      NSP14.Homological.totalBetti (NSP14.Lex.GenericDistractionField k q) (Fin q)
