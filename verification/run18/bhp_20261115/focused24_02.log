'NSP14.Lex.reversedPrefix_raised_balance' depends on axioms: [propext, Classical.choice, Quot.sound]
'NSP14.Lex.IsStronglyStable.mem_of_tail_le' depends on axioms: [propext, Classical.choice, Quot.sound]
NSP14.Lex.IsStronglyStable.mem_of_tail_le : ∀ (k : Type) [inst : Field k] (q : ℕ)
  (I : Ideal (MvPolynomial (Fin (q + 1)) k)),
  NSP14.Lex.IsStronglyStable k (q + 1) I →
    ∀ (α β : Fin (q + 1) →₀ ℕ),
      Finsupp.degree α = Finsupp.degree β →
        (∀ t ≤ q + 1, NSP14.Lex.reversedPrefix q β t ≤ NSP14.Lex.reversedPrefix q α t) →
          (MvPolynomial.monomial α) 1 ∈ I → (MvPolynomial.monomial β) 1 ∈ I
