  "adaptation": [
    "New namespace NSP14.SmallEmbedding.ThreeData",
    "Only structure lower bound q_one : 1 \u2264 a.card (old q_two was used only for nonemptiness)",
    "Replay all common actual endpoint proofs with the weaker positive-alphabet structure",
    "Generic Endpoint/ArithmeticSequence library declarations are reused, not duplicated",
    "Old Endpoint files and their public types remain unchanged"
  ],
  "scope": "Foundations only; no claim that the two remaining Run19 contracts are closed."
