{"axioms":["propext","Classical.choice","Quot.sound"],"body":"NSP14.Run19.Requested.FirstCount ∧\n  ∀ (S : NSP14.NumericalSemigroup) (k : Type) [inst : Field k] (he : S.embeddingDimension = 4),\n    S.width ≤ S.multiplicity - 2 → S.normalizedWidth = 5 ∨ 9 ≤ S.normalizedWidth → NSP14.Run19.Requested.Row S k ⋯ 1","explicit_body":"And NSP14.Run19.Requested.FirstCount\n  (∀ (S : NSP14.NumericalSemigroup) (k : Type) [inst : Field k]\n    (he : @Eq Nat S.embeddingDimension (@OfNat.ofNat Nat (nat_lit 4) (instOfNatNat (nat_lit 4)))),\n    @LE.le Nat instLENat S.width\n        (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) S.multiplicity\n          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) →\n      Or (@Eq Nat S.normalizedWidth (@OfNat.ofNat Nat (nat_lit 5) (instOfNatNat (nat_lit 5))))\n          (@LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 9) (instOfNatNat (nat_lit 9))) S.normalizedWidth) →\n        @NSP14.Run19.Requested.Row S k inst ⋯ (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))","name":"NSP14.Run19.Requested.N_FIRST","type":"Prop"}
{"axioms":["propext","Classical.choice","Quot.sound"],"body":"∀ (S : NSP14.NumericalSemigroup) (k : Type) [inst : Field k] (he : S.embeddingDimension = 4)\n  (hw : S.width ≤ S.multiplicity - 2),\n  have D := S.endpointData ⋯ hw;\n  D.u = 3 ∨ D.u = 5 ∨ D.u = 6 ∨ D.u = 7 ∨ D.u = 8 ∨ D.u = 4 ∧ (D.d ≠ 1 ∨ D.a ≠ {1, 3}) →\n    NSP14.Run18.Requested.Comparison S k ⋯","explicit_body":"∀ (S : NSP14.NumericalSemigroup) (k : Type) [inst : Field k]\n  (he : @Eq Nat S.embeddingDimension (@OfNat.ofNat Nat (nat_lit 4) (instOfNatNat (nat_lit 4))))\n  (hw :\n    @LE.le Nat instLENat S.width\n      (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) S.multiplicity\n        (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))),\n  have D := S.endpointData ⋯ hw;\n  Or (@Eq Nat D.u (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))))\n      (Or (@Eq Nat D.u (@OfNat.ofNat Nat (nat_lit 5) (instOfNatNat (nat_lit 5))))\n        (Or (@Eq Nat D.u (@OfNat.ofNat Nat (nat_lit 6) (instOfNatNat (nat_lit 6))))\n          (Or (@Eq Nat D.u (@OfNat.ofNat Nat (nat_lit 7) (instOfNatNat (nat_lit 7))))\n            (Or (@Eq Nat D.u (@OfNat.ofNat Nat (nat_lit 8) (instOfNatNat (nat_lit 8))))\n              (And (@Eq Nat D.u (@OfNat.ofNat Nat (nat_lit 4) (instOfNatNat (nat_lit 4))))\n                (Or (@Ne Nat D.d (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))\n                  (@Ne (Finset Nat) D.a\n                    (@insert Nat (Finset Nat) (@Finset.instInsert Nat instDecidableEqNat)\n                      (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))\n                      (@singleton Nat (Finset Nat) (@Finset.instSingleton Nat)\n                        (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3)))))))))))) →\n    @NSP14.Run18.Requested.Comparison S k inst ⋯","name":"NSP14.Run19.Requested.N_SMALL","type":"Prop"}
{"axioms":["propext","Classical.choice","Quot.sound"],"body":"∀ (D : NSP14.Endpoint.Data) (k : Type) [inst : Field k] (hq : D.q = 2),\n  D.d * D.u + 2 ≤ D.m → D.d = 1 → D.u = 4 → D.a = {1, 3} → NSP14.Run18.Requested.Comparison D.source k ⋯","explicit_body":"∀ (D : NSP14.Endpoint.Data) (k : Type) [inst : Field k]\n  (hq : @Eq Nat D.q (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))),\n  @LE.le Nat instLENat\n      (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) D.d D.u)\n        (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))\n      D.m →\n    @Eq Nat D.d (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) →\n      @Eq Nat D.u (@OfNat.ofNat Nat (nat_lit 4) (instOfNatNat (nat_lit 4))) →\n        @Eq (Finset Nat) D.a\n            (@insert Nat (Finset Nat) (@Finset.instInsert Nat instDecidableEqNat)\n              (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))\n              (@singleton Nat (Finset Nat) (@Finset.instSingleton Nat)\n                (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))))) →\n          @NSP14.Run18.Requested.Comparison D.source k inst ⋯","name":"NSP14.Run19.Requested.N_WIDTH4","type":"Prop"}
