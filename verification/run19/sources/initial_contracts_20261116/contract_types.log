{"axioms":["propext","Classical.choice","Quot.sound"],"body":"∀ (D : NSP14.Endpoint.Data) (k : Type) [inst : Field k] (hq : D.q = 2) (a b : ↥D.a),\n  NSP14.NarrowFour.OrderedPair D a b →\n    4 * (D.wordVolume - 1) ≤ D.u ^ 2 ∧\n      (D.internalSigma k hq + 1).choose 2 ≤ D.coreP k ∧\n        D.internalSigma k hq ≤ D.u - 1 ∧\n          D.coreP k = (NSP14.NarrowFour.standardWords D a b).card ∧\n            (∀ (p q : ℕ × ℕ), NSP14.NarrowFour.Standard D a b p → q ≤ p → NSP14.NarrowFour.Standard D a b q) ∧\n              ∀ (s t : ℕ), s + t ≤ D.internalSigma k hq - 1 → NSP14.NarrowFour.Standard D a b (s, t)","explicit_body":"∀ (D : NSP14.Endpoint.Data) (k : Type) [inst : Field k]\n  (hq : @Eq Nat D.q (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) (a b : ↥D.a),\n  NSP14.NarrowFour.OrderedPair D a b →\n    And\n      (@LE.le Nat instLENat\n        (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) (@OfNat.ofNat Nat (nat_lit 4) (instOfNatNat (nat_lit 4)))\n          (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) D.wordVolume\n            (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))\n        (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) D.u\n          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))))\n      (And\n        (@LE.le Nat instLENat\n          ((@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) (@NSP14.Endpoint.Data.internalSigma D k inst hq)\n                (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))).choose\n            (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))\n          (@NSP14.Endpoint.Data.coreP D k inst))\n        (And\n          (@LE.le Nat instLENat (@NSP14.Endpoint.Data.internalSigma D k inst hq)\n            (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) D.u\n              (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))\n          (And\n            (@Eq Nat (@NSP14.Endpoint.Data.coreP D k inst)\n              (@Finset.card (Prod Nat Nat) (NSP14.NarrowFour.standardWords D a b)))\n            (And\n              (∀ (p q : Prod Nat Nat),\n                NSP14.NarrowFour.Standard D a b p →\n                  @LE.le (Prod Nat Nat) (@Prod.instLE_mathlib Nat Nat instLENat instLENat) q p →\n                    NSP14.NarrowFour.Standard D a b q)\n              (∀ (s t : Nat),\n                @LE.le Nat instLENat (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) s t)\n                    (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) (@NSP14.Endpoint.Data.internalSigma D k inst hq)\n                      (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))) →\n                  NSP14.NarrowFour.Standard D a b (@Prod.mk Nat Nat s t))))))","name":"NSP14.Run19.Requested.N_DISTANCE","type":"Prop"}
{"axioms":["propext","Classical.choice","Quot.sound"],"body":"∀ (D : NSP14.Endpoint.Data) (k : Type) [inst : Field k],\n  D.q = 2 →\n    ∀ (a b : ↥D.a),\n      NSP14.NarrowFour.OrderedPair D a b →\n        (∀ (s : ℕ), NSP14.NarrowFour.Standard D a b (s, 0) → s ≤ D.u - 2) ∧\n          (∀ (t : ℕ), NSP14.NarrowFour.Standard D a b (0, t) → t ≤ D.u - 2) ∧\n            (∀ (s t : ℕ), 0 < s → 0 < t → NSP14.NarrowFour.Standard D a b (s, t) → 2 * (s + t) ≤ D.u) ∧\n              D.coreHeight ≤ D.u - 3 ∧ (D.u ≤ 4 → D.actualR k = 0)","explicit_body":"∀ (D : NSP14.Endpoint.Data) (k : Type) [inst : Field k],\n  @Eq Nat D.q (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) →\n    ∀ (a b : ↥D.a),\n      NSP14.NarrowFour.OrderedPair D a b →\n        And\n          (∀ (s : Nat),\n            NSP14.NarrowFour.Standard D a b\n                (@Prod.mk Nat Nat s (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))) →\n              @LE.le Nat instLENat s\n                (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) D.u\n                  (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))))\n          (And\n            (∀ (t : Nat),\n              NSP14.NarrowFour.Standard D a b\n                  (@Prod.mk Nat Nat (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) t) →\n                @LE.le Nat instLENat t\n                  (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) D.u\n                    (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))))\n            (And\n              (∀ (s t : Nat),\n                @LT.lt Nat instLTNat (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) s →\n                  @LT.lt Nat instLTNat (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) t →\n                    NSP14.NarrowFour.Standard D a b (@Prod.mk Nat Nat s t) →\n                      @LE.le Nat instLENat\n                        (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)\n                          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))\n                          (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) s t))\n                        D.u)\n              (And\n                (@LE.le Nat instLENat D.coreHeight\n                  (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) D.u\n                    (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3)))))\n                (@LE.le Nat instLENat D.u (@OfNat.ofNat Nat (nat_lit 4) (instOfNatNat (nat_lit 4))) →\n                  @Eq Nat (@NSP14.Endpoint.Data.actualR D k inst)\n                    (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))))","name":"NSP14.Run19.Requested.N_WORDS","type":"Prop"}
