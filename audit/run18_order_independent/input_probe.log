gradedBetti_total : ∀ (k : Type u_1) [inst : Field k] (σ : Type u_1) [inst_1 : Fintype σ]
  (M :
    @ModuleCat (@VariableRing k σ (@Field.toCommRing k inst))
      (@AddMonoidAlgebra.ring k (@Finsupp σ Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
        (@DivisionRing.toRing k (@Field.toDivisionRing k inst)) (@Finsupp.instAddMonoid σ Nat Nat.instAddMonoid)))
  [inst_2 :
    @Module.Finite (@VariableRing k σ (@Field.toCommRing k inst))
      (@ModuleCat.carrier (@VariableRing k σ (@Field.toCommRing k inst))
        (@AddMonoidAlgebra.ring k (@Finsupp σ Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
          (@DivisionRing.toRing k (@Field.toDivisionRing k inst)) (@Finsupp.instAddMonoid σ Nat Nat.instAddMonoid))
        M)
      (@AddMonoidAlgebra.semiring k (@Finsupp σ Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
        (@CommSemiring.toSemiring k (@CommRing.toCommSemiring k (@Field.toCommRing k inst)))
        (@Finsupp.instAddMonoid σ Nat Nat.instAddMonoid))
      (@AddCommGroup.toAddCommMonoid
        (@ModuleCat.carrier (@VariableRing k σ (@Field.toCommRing k inst))
          (@AddMonoidAlgebra.ring k (@Finsupp σ Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
            (@DivisionRing.toRing k (@Field.toDivisionRing k inst)) (@Finsupp.instAddMonoid σ Nat Nat.instAddMonoid))
          M)
        (@ModuleCat.isAddCommGroup (@VariableRing k σ (@Field.toCommRing k inst))
          (@AddMonoidAlgebra.ring k (@Finsupp σ Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
            (@DivisionRing.toRing k (@Field.toDivisionRing k inst)) (@Finsupp.instAddMonoid σ Nat Nat.instAddMonoid))
          M))
      (@ModuleCat.isModule (@VariableRing k σ (@Field.toCommRing k inst))
        (@AddMonoidAlgebra.ring k (@Finsupp σ Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
          (@DivisionRing.toRing k (@Field.toDivisionRing k inst)) (@Finsupp.instAddMonoid σ Nat Nat.instAddMonoid))
        M)]
  (G : @GradedPolynomialModule k inst σ M) (i : Nat),
  ∃ s,
    And
      (∀ t ∉ s,
        @Limits.IsZero (@ModuleCat k (@DivisionRing.toRing k (@Field.toDivisionRing k inst)))
          (@ModuleCat.moduleCategory k (@DivisionRing.toRing k (@Field.toDivisionRing k inst)))
          (@HomologicalComplex.homology (@ModuleCat k (@DivisionRing.toRing k (@Field.toDivisionRing k inst)))
            (@ModuleCat.moduleCategory k (@DivisionRing.toRing k (@Field.toDivisionRing k inst)))
            (@Preadditive.preadditiveHasZeroMorphisms
              (@ModuleCat k (@DivisionRing.toRing k (@Field.toDivisionRing k inst)))
              (@ModuleCat.moduleCategory k (@DivisionRing.toRing k (@Field.toDivisionRing k inst)))
              (@ModuleCat.instPreadditive k (@DivisionRing.toRing k (@Field.toDivisionRing k inst))))
            Nat
            (@ComplexShape.down Nat
              (@AddSemigroup.toAdd Nat
                (@AddRightCancelSemigroup.toAddSemigroup Nat
                  (@AddRightCancelMonoid.toAddRightCancelSemigroup Nat
                    (@AddCancelMonoid.toAddRightCancelMonoid Nat
                      (@AddCancelCommMonoid.toAddCancelMonoid Nat Nat.instAddCancelCommMonoid)))))
              ⋯ Nat.instOne)
            (@gradedKoszulComplex k σ inst M G (@variableList k σ inst_1) t) i ⋯))
      (@Eq Nat (@totalBetti k σ inst inst_1 M inst_2 i) (∑ t ∈ s, @gradedBetti k inst σ inst_1 M G i t))
