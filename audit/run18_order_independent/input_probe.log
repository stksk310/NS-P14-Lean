          (@NSP14.NumericalSemigroup.FormalTangentAlgebra (S.intervalCompletion he) k (@Field.toCommRing k inst))
          (@DirectSum.instAddCommGroup Nat
            (fun n =>
              @NSP14.NumericalSemigroup.FormalGradedPiece (S.intervalCompletion he) k (@Field.toCommRing k inst) n)
            (@NSP14.NumericalSemigroup.formalPieceAddCommGroup (S.intervalCompletion he) k (@Field.toCommRing k inst)))
          (@Algebra.toModule
            (@NSP14.NumericalSemigroup.FullPolynomialRing (S.intervalCompletion he) k (@Field.toCommRing k inst))
            (@NSP14.NumericalSemigroup.FormalTangentAlgebra (S.intervalCompletion he) k (@Field.toCommRing k inst))
            (@AddMonoidAlgebra.commSemiring k
              (@Finsupp (S.intervalCompletion he).AtomExponent Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
              (@Semifield.toCommSemiring k (@Field.toSemifield k inst))
              (@Finsupp.instAddCommMonoid (S.intervalCompletion he).AtomExponent Nat Nat.instAddCommMonoid))
            (@DirectSum.semiring Nat instDecidableEqNat
              (@NSP14.NumericalSemigroup.FormalGradedPiece (S.intervalCompletion he) k (@Field.toCommRing k inst))
              (fun i =>
                @Submodule.Quotient.addCommMonoid k
                  (↥(@NSP14.NumericalSemigroup.formalPowerModule (S.intervalCompletion he) k (@Field.toCommRing k inst)
                      i))
                  (@CommRing.toRing k (@Field.toCommRing k inst))
                  (@Submodule.addCommGroup k
                    (@NSP14.NumericalSemigroup.FormalSemigroupRing (S.intervalCompletion he) k
