NSP14.Endpoint.Data.QCore_internal_basis (D : NSP14.Endpoint.Data) (k : Type) [Field k] (b : ↥D.a)
  (p : D.CoreMinimalIndex) :
  (D.internalToQCore k) (MvPolynomial.X b) * (D.QCoreBasis k) p =
    if h : D.CoreMinimal (↑p + D.coreGeneratorPoint (D.internalVariable b)) then
      (D.QCoreBasis k) ⟨↑p + D.coreGeneratorPoint (D.internalVariable b), h⟩
    else 0
NSP14.Endpoint.Data.coreP_le_wordVolume (D : NSP14.Endpoint.Data) (k : Type) [Field k] : D.coreP k ≤ D.wordVolume
NSP14.Endpoint.Data.actualR_le_volume (D : NSP14.Endpoint.Data) (k : Type) [Field k] : D.actualR k ≤ D.wordVolume - D.u
NSP14.Endpoint.Data.actualR_le_height (D : NSP14.Endpoint.Data) (k : Type) [Field k] :
  D.actualR k ≤ D.u * (D.coreHeight - 2)
NSP14.Endpoint.Data.actual_positive_rows_add (D : NSP14.Endpoint.Data) (k : Type) [Field k] (i : ℕ) (hi : 1 ≤ i) :
  totalBetti k D.Variables (D.fullG k) i + (D.q + 1).choose (i + 1) ≤
    D.coreP k * (D.q + 1).choose i + D.Rhat * (D.q + 1).choose (i - 1)
NSP14.Endpoint.Data.QCore_first_harmonic (D : NSP14.Endpoint.Data) (k : Type) [Field k] :
  ↑(totalBetti k (↥D.a) (D.QCoreModule k) 1) ≤
    ↑D.q + ∑ n ∈ Finset.range (D.u - 1), ↑(D.q - 1) * ↑(D.coreHilbert k (n + 1)) / (↑n + 2)
NSP14.Endpoint.Data.QCore_first_third (D : NSP14.Endpoint.Data) (k : Type) [Field k] :
  ↑(totalBetti k (↥D.a) (D.QCoreModule k) 1) ≤ (↑D.q - 1) * ↑(D.coreP k) / 3 + (↑D.q + 1) * (↑D.q + 2) / 6
NSP14.Endpoint.Data.QCore_first_fourth (D : NSP14.Endpoint.Data) (k : Type) [Field k] :
  ↑(totalBetti k (↥D.a) (D.QCoreModule k) 1) ≤
    (↑D.q - 1) * ↑(D.coreP k) / 4 + (↑D.q + 1) ^ 2 / 4 + (↑D.q - 1) * ↑(D.coreHilbert k 2) / 12
NSP14.Endpoint.Data.wordVolume_tail (D : NSP14.Endpoint.Data) :
  D.wordVolume = 1 + ∑ n ∈ Finset.range D.u, (D.u - (NSP14.Additive.iteratedSum D.residueAlphabet n).card)
NSP14.Endpoint.Data.wordVolume_growth_bound (D : NSP14.Endpoint.Data) :
  D.wordVolume ≤ D.u + ∑ j ∈ Finset.range D.u, (D.u - (D.q + 1) - (D.q + 2) / 2 * j)
NSP14.Additive.fourPoint_growth {u : ℕ} [NeZero u] (A : Finset (ZMod u)) (h0 : 0 ∈ A) (hA : A.card = 4)
  (hgen : AddSubgroup.closure ↑A = ⊤) (hnot : ¬NSP14.Additive.CyclicAntipodal u A) (n : ℕ) :
  min u (3 * n + 1) ≤ (NSP14.Additive.iteratedSum A n).card
NSP14.Homological.gradedBetti_total.{u} (k : Type u) [Field k] (σ : Type u) [Fintype σ]
  (M : ModuleCat (VariableRing k σ)) [Module.Finite (VariableRing k σ) ↑M] (G : GradedPolynomialModule k σ M) (i : ℕ) :
  ∃ s,
    (∀ t ∉ s, Limits.IsZero (HomologicalComplex.homology (gradedKoszulComplex k σ M G (variableList k σ) t) i)) ∧
      totalBetti k σ M i = ∑ t ∈ s, gradedBetti k σ M G i t
