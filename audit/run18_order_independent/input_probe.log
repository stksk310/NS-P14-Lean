                      (@NSP14.NumericalSemigroup.formalSemigroupAlgebra (S.intervalCompletion he) k
                        (@Field.toCommRing k inst)))
                    (@NSP14.NumericalSemigroup.formalPowerModule (S.intervalCompletion he) k (@Field.toCommRing k inst)
                      i))
                  (@Submodule.module k
                    (@NSP14.NumericalSemigroup.FormalSemigroupRing (S.intervalCompletion he) k
                      (@Field.toCommRing k inst))
                    (@CommSemiring.toSemiring k (@CommRing.toCommSemiring k (@Field.toCommRing k inst)))
                    (@Semiring.toAddCommMonoid
                      (@NSP14.NumericalSemigroup.FormalSemigroupRing (S.intervalCompletion he) k
