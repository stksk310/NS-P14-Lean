                    (@CommRing.toRing k (@Field.toCommRing k inst))
                    (@Ring.toAddCommGroup
                      (@NSP14.NumericalSemigroup.FormalSemigroupRing (S.intervalCompletion he) k
                        (@Field.toCommRing k inst))
                      (@CommRing.toRing
                        (@NSP14.NumericalSemigroup.FormalSemigroupRing (S.intervalCompletion he) k
                          (@Field.toCommRing k inst))
                        (@NSP14.NumericalSemigroup.formalSemigroupCommRing (S.intervalCompletion he) k
                          (@Field.toCommRing k inst))))
                    (@Algebra.toModule k
                      (@NSP14.NumericalSemigroup.FormalSemigroupRing (S.intervalCompletion he) k
                        (@Field.toCommRing k inst))
                      (@CommRing.toCommSemiring k (@Field.toCommRing k inst))
                      (@Subalgebra.toSemiring k (PowerSeries k) (@CommRing.toCommSemiring k (@Field.toCommRing k inst))
                        (@MvPowerSeries.instSemiring Unit k
                          (@CommSemiring.toSemiring k (@CommRing.toCommSemiring k (@Field.toCommRing k inst))))
                        (@MvPowerSeries.instAlgebra Unit k k (@CommRing.toCommSemiring k (@Field.toCommRing k inst))
                          (@CommSemiring.toSemiring k (@CommRing.toCommSemiring k (@Field.toCommRing k inst)))
                          (@Algebra.id k (@CommRing.toCommSemiring k (@Field.toCommRing k inst))))
                        (@NSP14.NumericalSemigroup.formalSeriesAlgebra (S.intervalCompletion he) k
