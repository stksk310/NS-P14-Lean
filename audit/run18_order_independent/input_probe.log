NSP14.Endpoint.Data.actual_core_endpoint_bound : ∀ (D : NSP14.Endpoint.Data) (k : Type) [inst : Field k] (i : Nat),
  @LE.le Nat instLENat
    (@totalBetti k D.Variables inst (@Finset.Subtype.fintype Nat D.offsets) (@NSP14.Endpoint.Data.fullG D k inst) ⋯ i)
    (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
      (@totalBetti k (↥D.a) inst (@Finset.Subtype.fintype Nat D.a) (@NSP14.Endpoint.Data.QCoreModule D k inst) ⋯ i)
      (@NSP14.Endpoint.Data.coreRemainder D k inst i))
