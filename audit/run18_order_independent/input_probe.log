      (@totalBetti k (S.intervalCompletion he).AtomExponent inst (S.intervalCompletion he).atomExponentFintype
        (@ModuleCat.of
          (@NSP14.NumericalSemigroup.FullPolynomialRing (S.intervalCompletion he) k (@Field.toCommRing k inst))
          (@AddMonoidAlgebra.ring k
            (@Finsupp (S.intervalCompletion he).AtomExponent Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass))
            (@DivisionRing.toRing k (@Field.toDivisionRing k inst))
